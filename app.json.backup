{
  "expo": {
    "name": "Aashay Clinic",
    "slug": "docexa-patient-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_new.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pranavssutar.docexapatient"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pranavssutar.docexapatient"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon_new.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["@react-native-google-signin/google-signin"],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b93e2f5-a8aa-4f89-a5fb-a381c28bcf43"
      }
    },
    "owner": "pranavsutar123"
  }
}
