{
  "cli": {
    "version": ">= 5.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "ndk": "25.1.8937393"
      },
      "ios": {
        "simulator": true
      }
    },

    "production": {
      "android": {
        "buildType": "apk",
        "ndk": "25.1.8937393"
      }
    },

    "aashay": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CLIENT_ID": "1"
      }
    },

    "suraj": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CLIENT_ID": "2"
      }
    }
  },

  "submit": {
    "production": {}
  }
}
